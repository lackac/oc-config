{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "solarized"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "paste": "full"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "terminal": {
    "copy": "manual"
  },
  "plugins": [
    {
      "package": "./plugins/rich-copy",
      "options": {
        "automatic": true
      }
    }
  ],
  "animations": true
}
