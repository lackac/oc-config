{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "openai/gpt-6-sol",
  "default_agent": "build",
  "agents": {
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-6-astra#medium"
    },
    "build": {
      "mode": "primary",
      "model": "openai/gpt-6-sol#medium"
    },
    "title": {
      "model": "opencode/gpt-6-luna"
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/nix/store/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/Users/lackac/Code/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/Users/lackac/Life/*", "effect": "allow" }
  ],
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000
  },
}
