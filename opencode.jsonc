{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "openai/gpt-6.2-sol",
  "default_agent": "build",
  "skills": [
    "~/.config/opencode/vendor/matt-pocock-skills/skills/engineering",
    "~/.config/opencode/vendor/matt-pocock-skills/skills/productivity"
  ],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["/etc/profiles/per-user/lackac/bin/browse", "mcp"]
      }
    }
  },
  "agents": {
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-6.2-sol#max"
    },
    "build": {
      "mode": "primary",
      "model": "openai/gpt-6.2-sol#high"
    },
    "title": {
      "model": "openai/gpt-6-luna#none"
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/nix/store/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/Users/lackac/Code/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/Users/lackac/Life/*", "effect": "allow" }
  ],
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 20000
  },
}
